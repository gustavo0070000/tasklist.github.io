{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "pt-BR": {
          "name": "Nossa Lista",
          "summary": "Lista de tarefas, agenda e recados do Gustavo e da Isabella.",
          "description": "Abre o painel do casal na Echo Show e permite adicionar tarefas, itens do mercado, recados e consultar a agenda do dia por voz.",
          "examplePhrases": [
            "Alexa, abre nossa lista",
            "Alexa, pede pra nossa lista comprar leite",
            "Alexa, pergunta pra nossa lista o que tem pra hoje"
          ],
          "keywords": [
            "tarefas",
            "casal",
            "agenda"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "BR"
      ],
      "category": "ORGANIZERS_AND_ASSISTANTS"
    },
    "apis": {
      "custom": {
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              { "mode": "HUB", "shape": "RECTANGLE", "minWidth": 1024, "maxWidth": 1920, "minHeight": 600, "maxHeight": 1280 },
              { "mode": "HUB", "shape": "RECTANGLE", "minWidth": 960, "maxWidth": 1280, "minHeight": 480, "maxHeight": 800 },
              { "mode": "HUB", "shape": "ROUND", "minWidth": 480, "maxWidth": 480, "minHeight": 480, "maxHeight": 480 },
              { "mode": "TV", "shape": "RECTANGLE", "minWidth": 960, "maxWidth": 1920, "minHeight": 540, "maxHeight": 1080 },
              { "mode": "MOBILE", "shape": "RECTANGLE", "minWidth": 600, "maxWidth": 1280, "minHeight": 400, "maxHeight": 960 }
            ]
          }
        ]
      }
    },
    "manifestVersion": "1.0",
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "pt-BR": {
          "privacyPolicyUrl": "",
          "termsOfUseUrl": ""
        }
      }
    }
  }
}